                "description": "Number of items to skip before starting to return results"
              },
              {
                "name": "orderDirection",
                "value": "",
                "type": "query",
                "description": "Direction of sorting"
              },
              {
                "name": "orderBy",
                "value": "",
                "type": "query",
                "description": "Field to sort the results by"
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Search query to filter layouts"
              }
