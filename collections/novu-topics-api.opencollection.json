            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a topic by its unique key identifier **topicKey**"
        },
        {
          "info": {
            "name": "Novu Update a Topic",
