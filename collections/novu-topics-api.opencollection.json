{
  "opencollection": "1.0.0",
  "info": {
    "name": "Novu Activity Topics API",
    "version": "3.15.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Topics",
